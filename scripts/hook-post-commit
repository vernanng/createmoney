#!/bin/sh
# post-commit hook: remind about .md updates after every commit.
# Installed by `cargo xtask install-hooks` (symlinked into .git/hooks).
# Advisory only: never fails. Prefers a prebuilt xtask binary; falls
# back to `cargo run` on a fresh clone.
root=$(git rev-parse --show-toplevel) || exit 0
if [ -x "$root/target/release/xtask" ]; then
  "$root/target/release/xtask" doc-check || true
elif [ -x "$root/target/debug/xtask" ]; then
  "$root/target/debug/xtask" doc-check || true
else
  (cd "$root" && cargo run --quiet -p xtask -- doc-check) || true
fi
exit 0
