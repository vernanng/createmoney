# Fill locally, never commit real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Public static market-data token from Indodax's WebSocket docs (not a
# trading credential). Required for the live Indodax book feed.
INDODAX_WS_TOKEN=
# Binance spot WS base override. Set to the spot testnet while developing
# (wss://stream.testnet.binance.vision:9443); leave empty for mainnet books.
BINANCE_WS_URL=
EVM_RPC_URL=
SOLANA_RPC_URL=
# Optional control-API token. When set, POST /kill /revive /pause /resume
# need ?token=<value>. Leave empty for localhost-only paper runs.
API_TOKEN=
RUST_LOG=info
