# Fill locally, never commit real values.
# Blank WS_* = mainnet books. Blank *_API_BASE = testnet sends.

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Testnet books: wss://stream.testnet.binance.vision:9443
BINANCE_WS_URL=
# Testnet sends (refuses anything but https://testnet.binance.vision)
BINANCE_API_BASE=

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Testnet books: wss://stream-testnet.bybit.com/v5/public/spot
BYBIT_WS_URL=
# Testnet sends (refuses anything but https://api-testnet.bybit.com)
BYBIT_API_BASE=

# --- OKX (no sender yet) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Indodax (no sender yet) ---
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Public market-data token, not a trading credential. Required for books.
INDODAX_WS_TOKEN=

# --- Chains (testnet probes) ---
# Sepolia HTTPS RPC (any endpoint works).
EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# WSS endpoints reserved for future subscription feeds (unused today).
EVM_WSS_URL=
# Solana devnet HTTPS RPC.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Solana WSS endpoint (reserved, unused today).
SOLANA_WSS_URL=
# Public addresses (not secrets).
EVM_ADDRESS=
SOLANA_ADDRESS=
# TESTNET private keys only — never mainnet keys.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# --- Misc ---
# When set, POST /kill /revive /pause /resume need ?token=<value>.
API_TOKEN=
RUST_LOG=info
