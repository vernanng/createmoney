# Fill locally, never commit real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
INDODAX_API_KEY=
INDODAX_API_SECRET=
# Public static market-data token from Indodax's WebSocket docs (not a
# trading credential). Required for the live Indodax book feed.
INDODAX_WS_TOKEN=
# Binance spot WS base override. Set to the spot testnet while developing
# (wss://stream.testnet.binance.vision:9443); leave empty for mainnet books.
BINANCE_WS_URL=
# Binance spot REST base for live order sends. Testnet only — the sender
# refuses any other host. Leave empty for https://testnet.binance.vision.
BINANCE_API_BASE=
# Sepolia HTTPS RPC for the arb-dex-evm testnet probe (eth_chainId must be
# 11155111 before any send). Any HTTPS JSON-RPC endpoint works.
EVM_RPC_URL=
# EVM WSS endpoint, reserved for future subscription feeds (unused today).
EVM_WSS_URL=
# Solana devnet HTTPS RPC for the arb-dex-sol testnet probe (getGenesisHash
# must be EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG before any send).
SOLANA_RPC_URL=
# Solana WSS endpoint, reserved for future subscription feeds (unused today).
SOLANA_WSS_URL=
# Public wallet addresses (not secrets). Private keys stay out of these files.
EVM_ADDRESS=
SOLANA_ADDRESS=
# Private keys for TESTNET trading only (throwaway wallets — never mainnet
# keys). EVM: 0x hex. Solana: base58, 32-byte seed or 64-byte keypair export.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=
# Optional control-API token. When set, POST /kill /revive /pause /resume
# need ?token=<value>. Leave empty for localhost-only paper runs.
API_TOKEN=
RUST_LOG=info
